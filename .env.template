# Copy this file to ".env" and fill in your real values.
# .env is gitignored — never commit real keys.

# From https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=

# From your Supabase project: Settings -> API
# Use the project URL and the service_role key (backend only; keep secret).
SUPABASE_URL=
SUPABASE_KEY=

# From https://developer.adzuna.com  (register -> create an app -> copy both)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
